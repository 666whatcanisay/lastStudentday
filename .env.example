# ============================================================
# RAG 功能环境配置模板
# ============================================================
# 用法：复制本文件为 .env，填入真实值。
#   copy .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，不会提交到仓库。
# ⚠️ 不要把真实 Key 写进 .env.example 或任何代码文件。
#
# 未配置 LLM_API_KEY 时，RAG 问答会**优雅降级**：
# 不报错，而是返回检索到的原文片段 + 提示「未配置 LLM」，
# 因此可以先把检索链路跑通，之后随时补上 Key 即可生效，无需改代码。
# ============================================================

# ---------- 云端 LLM（OpenAI 兼容协议） ----------
# 可选：代码与数据分离。必须填含 data/、uploads/ 的数据根目录，不能填数据库文件。
# 启动、停止及离线恢复均读取本机 .env；进程环境变量优先。
# DOC_OCR_DATA_DIR=D:/DocOCRData
# 默认 DeepSeek。换其他厂商只需改 BASE_URL 与 MODEL 两行。
#
# 常用厂商参考：
#   DeepSeek   https://api.deepseek.com/v1        deepseek-chat
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4                glm-4-flash
#   Moonshot   https://api.moonshot.cn/v1         moonshot-v1-8k
#   OpenAI     https://api.openai.com/v1          gpt-4o-mini

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- 网络代理 ----------
# 是否让 HTTP 客户端读取系统环境变量里的 HTTP_PROXY / HTTPS_PROXY。
#
# 默认 false（直连）。原因：本机系统代理端口会随会话变化
# （历史出现过 52392、55212），一旦代理进程没启动，所有 LLM 调用会整体失败。
# 直连行为确定、不依赖外部进程。
#
# 如果你的网络环境必须通过代理才能访问外网 API，改成 true。
#   验证方法（两者都应返回 401，401 表示"能连通但没带 Key"）：
#     curl --noproxy '*' -o /dev/null -w "%{http_code}\n" https://api.deepseek.com/v1
#     curl -o /dev/null -w "%{http_code}\n" https://api.deepseek.com/v1
LLM_USE_ENV_PROXY=false

# ---------- 向量模型下载源 ----------
# 本机实测 huggingface.co 不可达（返回 000），必须走国内镜像
HF_ENDPOINT=https://hf-mirror.com
